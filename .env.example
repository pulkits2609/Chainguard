# Copy to .env. This file contains examples, not working credentials.
# Values are literal KEY=VALUE entries; shell commands and variable expansion are not supported.
LEDGER_DATABASE_URL=postgresql://chainguard_app:CHANGE_ME@127.0.0.1:5432/chainguard
LEDGER_TEST_DATABASE_URL=postgresql://chainguard_app:CHANGE_ME@127.0.0.1:5432/chainguard_test

# Hard integration limits. Individual policies may only reduce these values.
LEDGER_MAX_REQUESTS_PER_MINUTE=600
LEDGER_MAX_BODY_BYTES=65536
LEDGER_AUDIT_RETENTION_DAYS=30
LEDGER_CUSTOMER_ACCESS_SECONDS=86400
# Single-process pre-database gates and interactive history budgets.
LEDGER_PUBLIC_READS_PER_MINUTE=60
LEDGER_CUSTOMER_ATTEMPTS_PER_MINUTE=30
LEDGER_CONCURRENT_VERIFICATIONS=4
LEDGER_DB_STATEMENT_TIMEOUT_MS=5000
LEDGER_DB_LOCK_TIMEOUT_MS=2000
LEDGER_MAX_HISTORY_BYTES=33554432
# The above is the inspection/recovery read budget. New writes are additionally
# capped at 5 MiB of serialized blocks so full JSON and encrypted snapshots fit.
# Optional protected key files. Defaults: .local/chainguard/{checkpoint,integration}.key.
# These persistent files must be backed up; existing keys are never silently replaced.
# LEDGER_SIGNING_KEY_PATH=/var/lib/chainguard/checkpoint.key
# LEDGER_INTEGRATION_KEY_PATH=/var/lib/chainguard/integration.key

# Local development only. For HTTPS deployment use the settings below.
LEDGER_BIND=127.0.0.1
LEDGER_PORT=8000
LEDGER_ALLOWED_HOSTS=localhost,127.0.0.1
LEDGER_PUBLIC_ORIGIN=http://127.0.0.1:8000
LEDGER_DEV_MODE=true
LEDGER_SECURE_COOKIES=false

# Set these only for the explicit --init-admin command, then remove the password.
# Normal startup must not create or overwrite an administrator automatically.
LEDGER_ADMIN_USERNAME=
LEDGER_ADMIN_PASSWORD=

# HTTPS example: replace every path/hostname with your actual values.
# LEDGER_BIND=0.0.0.0
# LEDGER_PORT=8443
# LEDGER_ALLOWED_HOSTS=ledger.example.com
# LEDGER_PUBLIC_ORIGIN=https://ledger.example.com:8443
# LEDGER_DEV_MODE=false
# LEDGER_SECURE_COOKIES=true
# LEDGER_TLS_CERT=/etc/blockchainLedger/fullchain.pem
# LEDGER_TLS_KEY=/etc/blockchainLedger/private.key
